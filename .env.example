# ==========================================
# ClassSense Configuration Environment File
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default, PostgreSQL via env)
DATABASE_URL=sqlite+aiosqlite:///./classsense.db

# Storage Directories
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db

# LLM & Embeddings Provider Selection: "auto", "gemini", or "mistral"
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# Google Gemini (Active when GEMINI_API_KEY is provided)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Mistral AI (Optional alternative)
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_VOXTRAL_MODEL=voxtral-mini-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ASR Provider Configuration
# Options: "auto", "gemini_audio", "faster_whisper", "mistral_voxtral", "openai_whisper", "sarvam_ai"
ASR_PROVIDER=auto
FASTER_WHISPER_MODEL=base

# Optional Provider Adapters (Disabled unless keys provided)
OPENAI_API_KEY=
SARVAM_API_KEY=
