# ==========================================
# ClassSense Configuration Environment File
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (SQLite default with WAL mode, PostgreSQL via env)
DATABASE_URL=sqlite+aiosqlite:///./classsense.db

# Storage Directories & Ingestion Limits
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
MAX_UPLOAD_MB=500

# Provider Selection (Defaults to Mistral stack with faster-whisper local fallback)
LLM_PROVIDER=mistral
EMBEDDING_PROVIDER=mistral
ASR_PROVIDER=faster_whisper

# Mistral AI (Primary Cloud Provider)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_VOXTRAL_MODEL=voxtral-mini-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Google Gemini (Optional Cloud Adapter - Active when GEMINI_API_KEY is configured)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ASR & Audio Processing Configuration
FASTER_WHISPER_MODEL=base
AUDIO_CHUNK_DURATION_SECONDS=300.0
AUDIO_CHUNK_OVERLAP_SECONDS=5.0

# Confusion Engine Configuration (30-60s sliding windows, signal + LLM weights)
CONFUSION_WINDOW_SIZE_SECONDS=45.0
CONFUSION_WINDOW_STEP_SECONDS=15.0
CONFUSION_SIGNAL_WEIGHT=0.40
CONFUSION_LLM_WEIGHT=0.60
CONFUSION_MIN_SCORE=0.35

# Report Pacing Bands (Words Per Minute)
WPM_BAND_SLOW_MAX=110.0
WPM_BAND_FAST_MIN=180.0

# Provider Resilience & Concurrency Limits
PROVIDER_CALL_TIMEOUT_SECONDS=60.0
PROVIDER_MAX_CONCURRENCY=3
PROVIDER_MAX_RETRIES=3

# Optional Provider Adapters (Disabled unless keys provided)
OPENAI_API_KEY=
SARVAM_API_KEY=
