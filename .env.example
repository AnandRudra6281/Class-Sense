# ==========================================
# ClassSense Configuration Environment File
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default, PostgreSQL via env)
DATABASE_URL=sqlite+aiosqlite:///./classsense.db

# Storage Directories
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db

# Mistral AI (Required for LLM, Embeddings, and primary Voxtral ASR)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_LLM_MODEL=mistral-large-latest
MISTRAL_VOXTRAL_MODEL=voxtral-mini-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ASR Provider Configuration
# Options: "mistral_voxtral", "faster_whisper", "openai_whisper", "sarvam_ai"
ASR_PROVIDER=mistral_voxtral
FASTER_WHISPER_MODEL=base

# Optional Provider Adapters (Disabled unless keys provided)
OPENAI_API_KEY=
SARVAM_API_KEY=
